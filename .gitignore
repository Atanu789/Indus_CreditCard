# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ──── Dependencies ────────────────────────────
node_modules/
package-lock.json

# ──── Environment / Secrets ───────────────────
.env
.env.*
!.env.example

# ──── Expo ────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ──── Server ──────────────────────────────────
server/dist/
server/node_modules/

# ──── Client ──────────────────────────────────
client/node_modules/
client/.expo/

# ──── Android / Native build outputs ──────────
*.apk
*.aab
*.dex
*.class
client/android/app/build/
client/android/build/
client/android/.gradle/
client/android/.idea/
client/android/local.properties
client/android/captures/
.kotlin/
*.hprof

# ──── Keystores / Signing ─────────────────────
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.pem

# ──── iOS (if ever added) ─────────────────────
/ios
*.xcworkspace
*.xcuserdata
Pods/

# ──── Metro ───────────────────────────────────
.metro-health-check*

# ──── Debug logs ──────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*

# ──── OS junk ─────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ──── IDE / Editor ────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ──── TypeScript ──────────────────────────────
*.tsbuildinfo

# ──── Misc ────────────────────────────────────
*.log
*.tmp
*.bak
